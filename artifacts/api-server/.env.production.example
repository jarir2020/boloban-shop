# Production environment for the api-server.
# Copy this to `.env` on the server (deploy.sh does this for you).
#
# Required:
DATABASE_URL=mysql://bengalii_boloban_db:bengalii_boloban_db@localhost:3306/bengalii_boloban_db
PORT=8080
NODE_ENV=production

# Auth — leave the bypass on if you don't have Clerk keys yet. The api-server
# will then skip the clerkMiddleware and treat everyone as a signed-in dev
# user (matches the local dev experience). Set to "false" once you have real
# Clerk credentials configured.
CLERK_DEV_BYPASS=true
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# CLERK_SECRET_KEY=sk_test_replace_me
# CLERK_PUBLISHABLE_KEY=pk_test_replace_me
