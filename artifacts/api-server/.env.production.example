# Production environment for the api-server.
# Copy this to `.env` on the server (deploy.sh does this for you).
#
# Required:
DATABASE_URL=mysql://bengalii_boloban_db:bengalii_boloban_db@localhost:3306/bengalii_boloban_db
PORT=8080
NODE_ENV=production

# Custom auth: no Clerk involved.  Sessions live in
# marketplace_sessions, passwords are scrypt-hashed in marketplace_users.
# The /api/auth/* routes are mounted under /api.

# DEV_SEED_KEY is the shared secret for POST /api/dev/seed-users.
# Without it, the endpoint returns 403.  Set this to a long random
# string and keep it private.  Rotate by changing the value and
# redeploying — already-seeded users are kept.
DEV_SEED_KEY=replace-with-a-long-random-string

# Session cookie maxAge in milliseconds.  Default is 30 days.
# SESSION_TTL_MS=2592000000
