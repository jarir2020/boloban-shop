<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass API calls through to Apache/cPanel proxy rules
  RewriteRule ^api/ - [L]

  # Serve existing files and directories directly (images, js, css, test.php, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all client-side SPA paths (e.g. /admin, /seller, /cart) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

